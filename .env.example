# This copy is the reference; .env is never committed. No CMS, so there are
# no CMS tokens, draft secrets or cache-purge keys to set.

# ── Site ─────────────────────────────────────────────────────────────────────

# The public origin: canonical URLs, share images, llms.txt.
NUXT_PUBLIC_SITE_URL=

# Flip to true when the real domain goes live — and remove the X-Robots-Tag
# block from netlify.toml at the same time.
NUXT_PUBLIC_INDEXABLE=false

# Staging only: user:pass turns on HTTP basic auth (and turns CDN caching off).
NUXT_BASIC_AUTH=

# ── Optional ─────────────────────────────────────────────────────────────────

# Form notifications. They also need recipients, which come from the cms
# adapter's settings() — empty until server/utils/no-cms.ts gives it some.
NUXT_RESEND_API_KEY=
NUXT_MAIL_FROM=

# Captcha. Without a secret, the honeypot and the timing trap still run.
NUXT_TURNSTILE_SECRET=
NUXT_PUBLIC_TURNSTILE_SITE_KEY=

# plausible | fathom | umami | ga. Empty loads nothing, and nothing loads in
# dev whatever this says.
NUXT_PUBLIC_ANALYTICS_PROVIDER=
NUXT_PUBLIC_ANALYTICS_SITE_ID=
